{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "env": {
    "VITE_RETELL_PUBLIC_KEY": "@vite_retell_public_key",
    "VITE_RETELL_AGENT_ID": "@vite_retell_agent_id"
  }
}
