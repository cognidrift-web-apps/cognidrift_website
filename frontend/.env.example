# SMTP Email Configuration
# Add these to your Vercel Environment Variables

# SMTP Server (from Namecheap cPanel)
SMTP_HOST=mail.cognidrift.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=465

# Set to "true" for port 465 (SSL), "false" for port 587 (TLS)
SMTP_SECURE=true

# Your full email address
SMTP_USER=contact@cognidrift.com

# Your email password from cPanel
SMTP_PASS=YourPasswordHere

# Display name for outgoing emails
SMTP_FROM_NAME=CogniDrift

# Your email address (usually same as SMTP_USER)
SMTP_FROM_EMAIL=contact@cognidrift.com
